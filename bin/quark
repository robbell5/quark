#!/usr/bin/env node
import {
  STEPS,
  UTILITIES,
  resolveQuarkRoot,
  parseArgs,
  engineTargets,
  install,
  uninstall,
} from "../src/lib.mjs";

const opts = parseArgs(process.argv.slice(2));
const root = resolveQuarkRoot(import.meta.url);
const total = STEPS.length + UTILITIES.length;

if (opts.command === "uninstall") {
  if (opts.dryRun) {
    const targets = engineTargets();
    for (const engine of opts.engines) {
      console.log(
        `[dry-run] ${engine}: would remove quark skills from ${targets[engine].outDir}` +
          ` and sweep legacy v0.3.0 files from ${targets[engine].legacyDir}`,
      );
    }
  } else {
    for (const { engine, outDir, count, legacyRemoved } of uninstall({
      engines: opts.engines,
    })) {
      console.log(`${engine}: removed ${count} skills from ${outDir}`);
      if (legacyRemoved) {
        console.log(`${engine}: swept ${legacyRemoved} legacy v0.3.0 files`);
      }
    }
  }
} else if (opts.command === "install") {
  if (opts.dryRun) {
    const targets = engineTargets();
    for (const engine of opts.engines) {
      console.log(
        `[dry-run] ${engine}: would write ${total} skills to ${targets[engine].outDir}` +
          ` and sweep legacy v0.3.0 files from ${targets[engine].legacyDir}`,
      );
    }
  } else {
    console.log(`Quark install — root: ${root}`);
    for (const { engine, outDir, count, legacyRemoved } of install({
      engines: opts.engines,
      root,
    })) {
      console.log(`${engine}: wrote ${count} skills to ${outDir}`);
      if (legacyRemoved) {
        console.log(`${engine}: swept ${legacyRemoved} legacy v0.3.0 files`);
      }
    }
    console.log(
      "Next: run /quark-config (Claude Code) or $quark-config (Codex) inside any repo you want to use Quark in.",
    );
  }
} else {
  console.error(
    `Unknown command: ${opts.command}. Use "install" or "uninstall".`,
  );
  process.exit(1);
}
