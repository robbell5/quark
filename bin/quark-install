#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import {
  STEPS,
  UTILITIES,
  resolveQuarkRoot,
  installEngine,
  parseArgs,
  engineTargets,
} from "../src/lib.mjs";

const opts = parseArgs(process.argv.slice(2));
const root = resolveQuarkRoot(import.meta.url);
const targets = engineTargets();

console.log(`Quark install — root: ${root}`);
for (const engine of opts.engines) {
  const { loopTemplate, configTemplate, outDir } = targets[engine];
  if (opts.dryRun) {
    const count = STEPS.length + UTILITIES.length;
    console.log(
      `[dry-run] ${engine}: would write ${count} commands to ${outDir}`,
    );
    continue;
  }
  const loopText = fs.readFileSync(path.join(root, loopTemplate), "utf8");
  const configText = fs.readFileSync(path.join(root, configTemplate), "utf8");
  const loop = installEngine({ template: loopText, outDir, root, steps: STEPS });
  const util = installEngine({
    template: configText,
    outDir,
    root,
    steps: UTILITIES,
  });
  console.log(
    `${engine}: wrote ${loop.length + util.length} commands to ${outDir}`,
  );
}

if (!opts.dryRun) {
  console.log(
    "Next: run /quark-config inside any repo you want to use Quark in.",
  );
}
